generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  LATE
  CANCELLED
}

enum ExecutorType {
  INTERNAL
  AGROLINK
}

enum CostCategory {
  INSUMO
  MAO_DE_OBRA
  MAQUINARIO
  AGROLINK
  OUTROS
}

model User {
  id                String             @id @default(uuid())
  supabaseId        String             @unique
  name              String
  email             String             @unique
  role              UserRole           @default(MANAGER)
  plan              String             @default("starter")
  stripeCustomerId  String?
  avatarUrl         String?
  phone             String?
  cpf               String?
  kycVerified       Boolean            @default(false)
  stripeAccountId   String?
  properties        Property[]
  pushSubscriptions PushSubscription[]
  tokenTransactions TokenTransaction[]
  createdAt         DateTime           @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model LaunchSubscriber {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Property {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  location     String?
  sizeHectares Decimal      @default(0)
  coverUrl     String?
  fields       Field[]
  activities   Activity[]
  costs        Cost[]
  revenues     Revenue[]
  teamMembers  TeamMember[]
  alerts       Alert[]
  goals        Goal[]
  agroRate     AgroRate?
  creditRequests CreditRequest[]
  agroTokens   AgroToken[]
  createdAt    DateTime     @default(now())
}

model Revenue {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String   @default("VENDA")
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Crop {
  id     String  @id @default(uuid())
  name   String
  season String?
  fields Field[]
}

model Field {
  id           String     @id @default(uuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cropId       String?
  crop         Crop?      @relation(fields: [cropId], references: [id])
  name         String
  sizeHectares Decimal    @default(0)
  activities   Activity[]
}

model Activity {
  id                String         @id @default(uuid())
  propertyId        String
  property          Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fieldId           String?
  field             Field?         @relation(fields: [fieldId], references: [id])
  assignedToId      String?
  assignedTo        TeamMember?    @relation(fields: [assignedToId], references: [id])
  type              String
  description       String?
  status            ActivityStatus @default(PENDING)
  executor          ExecutorType?  @default(INTERNAL)
  agrolinkServiceId     String?
  agrolinkStatus        String?
  startDate         DateTime
  endDate           DateTime?
  costs             Cost[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Cost {
  id          String       @id @default(uuid())
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    Activity?    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    CostCategory @default(OUTROS)
  description String?
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())
}

model TeamMember {
  id         String     @id @default(uuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  role       String
  phone      String?
  activities Activity[]
  createdAt  DateTime   @default(now())
}

model Alert {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  message    String
  type       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Goal {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   @default("REVENUE")
  targetValue Decimal
  currentValue Decimal @default(0)
  deadline    DateTime?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ScoreCategory {
  ELITE
  HIGH
  GOOD
  REGULAR
  LOW
  CRITICAL
}

model AgroRate {
  id             String        @id @default(uuid())
  propertyId     String        @unique
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  score          Int           @default(500)
  category       ScoreCategory @default(REGULAR)
  
  productionScore    Int        @default(0)
  efficiencyScore   Int        @default(0)
  behaviorScore     Int        @default(0)
  operationalScore  Int        @default(0)
  
  totalRevenue      Decimal    @default(0)
  totalCosts        Decimal    @default(0)
  productivity       Decimal    @default(0)
  marginRate        Decimal    @default(0)
  
  activityCount     Int        @default(0)
  paymentOnTimeRate Decimal    @default(0)
  dataCompleteness  Decimal    @default(0)
  
  benchmarkComparison Json?     @default("{}")
  trendHistory       Json?     @default("[]")
  
  lastCalculated    DateTime   @default(now())
  nextUpdate        DateTime?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum CreditRequestStatus {
  PENDING
  ANALYZING
  APPROVED
  REJECTED
  CANCELLED
  CONTRACTED
}

model CreditRequest {
  id              String              @id @default(uuid())
  propertyId      String
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  partnerId       String?
  partner         CreditPartner?      @relation(fields: [partnerId], references: [id])
  
  requestedAmount Decimal
  approvedAmount  Decimal?
  interestRate    Decimal?
  termMonths      Int?
  
  status          CreditRequestStatus @default(PENDING)
  rejectionReason String?
  
  proposals       Json?               @default("[]")
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model CreditPartner {
  id            String            @id @default(uuid())
  name          String
  type          String            @default("BANK")
  logoUrl       String?
  apiEndpoint   String?
  apiKey        String?
  
  isActive      Boolean           @default(true)
  priority      Int               @default(0)
  
  requests      CreditRequest[]
  offers        CreditOffer[]
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model CreditOffer {
  id              String            @id @default(uuid())
  partnerId       String
  partner         CreditPartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  
  minScore        Int               @default(0)
  maxScore        Int               @default(1000)
  
  minAmount       Decimal           @default(0)
  maxAmount       Decimal           @default(1000000)
  
  minRate         Decimal
  maxRate         Decimal
  
  minTerm         Int               @default(1)
  maxTerm         Int               @default(60)
  
  requirements    Json?             @default("{}")
  
  isActive        Boolean           @default(true)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}


model LearningClick {
  id        String   @id @default(uuid())
  moduleId  String
  clickedAt DateTime @default(now())

  @@index([moduleId, clickedAt])
}

enum TokenType {
  SAFRA
  MATERIAL
  MAQUINARIO
}

enum TokenStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REDEEMED
  CANCELLED
}

model AgroToken {
  id          String      @id @default(uuid())
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        TokenType
  status      TokenStatus @default(DRAFT)
  title       String
  description String?

  totalValue  Decimal
  tokenPrice  Decimal     @default(100)
  totalTokens Int
  soldTokens  Int         @default(0)

  expectedReturn Decimal?
  periodMonths   Int?

  // Safra
  commodity    String?
  quantityKg   Decimal?
  deliveryDate DateTime?
  fieldId      String?

  // Material
  materialType String?
  quantity     Decimal?
  unit         String?

  // Maquinário
  machineType  String?
  machineModel String?
  machineYear  Int?
  usageHours   Decimal?

  contractUrl       String?
  blockchainTx      String?
  originacaoFee     Decimal?
  successFee        Decimal?

  clicksignDocKey   String?
  clicksignSignerKey String?
  signedAt          DateTime?

  transactions TokenTransaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
}

model TokenTransaction {
  id            String    @id @default(uuid())
  tokenId       String
  token         AgroToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation(fields: [buyerId], references: [id])
  quantity      Int
  pricePerToken Decimal
  totalAmount   Decimal
  commission    Decimal
  type          String    @default("BUY")
  createdAt     DateTime  @default(now())

  @@index([tokenId])
  @@index([buyerId])
}
