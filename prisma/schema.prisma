generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  LATE
  CANCELLED
}

enum ExecutorType {
  INTERNAL
  AGROLINK
}

enum CostCategory {
  INSUMO
  MAO_DE_OBRA
  MAQUINARIO
  AGROLINK
  OUTROS
}

model User {
  id                String             @id @default(uuid())
  supabaseId        String             @unique
  name              String
  email             String             @unique
  role              UserRole           @default(MANAGER)
  plan              String             @default("starter")
  stripeCustomerId  String?
  avatarUrl         String?
  phone             String?
  cpf               String?
  kycVerified       Boolean            @default(false)
  stripeAccountId   String?
  properties        Property[]
  pushSubscriptions PushSubscription[]
  tokenTransactions TokenTransaction[]
  agentConfigs      AgentConfig[]
  fieldOperations   FieldOperation[]
  createdAt         DateTime           @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model LaunchSubscriber {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Property {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  location     String?
  lat                Float?
  lng                Float?
  waterVulnerability String?
  waterAnalysisData  Json?
  sizeHectares       Decimal      @default(0)
  coverUrl     String?
  fields       Field[]
  activities   Activity[]
  costs        Cost[]
  revenues     Revenue[]
  teamMembers  TeamMember[]
  alerts       Alert[]
  goals        Goal[]
  agroRate     AgroRate?
  creditRequests CreditRequest[]
  agroTokens    AgroToken[]
  energyRecords EnergyRecord[]
  lotes                Lote[]
  animais              Animal[]
  protocolosVacinais   ProtocoloVacinal[]
  pastagens            Pastagem[]
  planosNutricionais   PlanoNutricional[]
  transacoesGado       TransacaoGado[]
  valuations           ValuationRebanho[]
  tanquesAqua          TanqueAqua[]
  lotesAqua            LoteAqua[]
  createdAt    DateTime     @default(now())
}

model Revenue {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String   @default("VENDA")
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Crop {
  id     String  @id @default(uuid())
  name   String
  season String?
  fields Field[]
}

model Field {
  id           String     @id @default(uuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cropId       String?
  crop         Crop?      @relation(fields: [cropId], references: [id])
  name         String
  sizeHectares Decimal    @default(0)
  lat          Float?
  lng          Float?
  geoJson         String?
  activities      Activity[]
  fieldOperations FieldOperation[]
}

model Activity {
  id                String         @id @default(uuid())
  propertyId        String
  property          Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fieldId           String?
  field             Field?         @relation(fields: [fieldId], references: [id])
  assignedToId      String?
  assignedTo        TeamMember?    @relation(fields: [assignedToId], references: [id])
  type              String
  description       String?
  status            ActivityStatus @default(PENDING)
  executor          ExecutorType?  @default(INTERNAL)
  agrolinkServiceId     String?
  agrolinkStatus        String?
  startDate         DateTime
  endDate           DateTime?
  costs             Cost[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Cost {
  id          String       @id @default(uuid())
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    Activity?    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    CostCategory @default(OUTROS)
  description String?
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())
}

model TeamMember {
  id         String     @id @default(uuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  role       String
  phone      String?
  activities Activity[]
  createdAt  DateTime   @default(now())
}

model Alert {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  message    String
  type       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Goal {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   @default("REVENUE")
  targetValue Decimal
  currentValue Decimal @default(0)
  deadline    DateTime?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ScoreCategory {
  ELITE
  HIGH
  GOOD
  REGULAR
  LOW
  CRITICAL
}

model AgroRate {
  id             String        @id @default(uuid())
  propertyId     String        @unique
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  score          Int           @default(500)
  category       ScoreCategory @default(REGULAR)
  
  productionScore    Int        @default(0)
  efficiencyScore   Int        @default(0)
  behaviorScore     Int        @default(0)
  operationalScore  Int        @default(0)
  
  totalRevenue      Decimal    @default(0)
  totalCosts        Decimal    @default(0)
  productivity       Decimal    @default(0)
  marginRate        Decimal    @default(0)
  
  activityCount     Int        @default(0)
  paymentOnTimeRate Decimal    @default(0)
  dataCompleteness  Decimal    @default(0)
  
  benchmarkComparison Json?     @default("{}")
  trendHistory       Json?     @default("[]")
  
  lastCalculated    DateTime   @default(now())
  nextUpdate        DateTime?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum CreditRequestStatus {
  PENDING
  ANALYZING
  APPROVED
  REJECTED
  CANCELLED
  CONTRACTED
}

model CreditRequest {
  id              String              @id @default(uuid())
  propertyId      String
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  partnerId       String?
  partner         CreditPartner?      @relation(fields: [partnerId], references: [id])
  
  requestedAmount Decimal
  approvedAmount  Decimal?
  interestRate    Decimal?
  termMonths      Int?
  
  status          CreditRequestStatus @default(PENDING)
  rejectionReason String?
  
  proposals       Json?               @default("[]")
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model CreditPartner {
  id            String            @id @default(uuid())
  name          String
  type          String            @default("BANK")
  logoUrl       String?
  apiEndpoint   String?
  apiKey        String?
  
  isActive      Boolean           @default(true)
  priority      Int               @default(0)
  
  requests      CreditRequest[]
  offers        CreditOffer[]
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model CreditOffer {
  id              String            @id @default(uuid())
  partnerId       String
  partner         CreditPartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  
  minScore        Int               @default(0)
  maxScore        Int               @default(1000)
  
  minAmount       Decimal           @default(0)
  maxAmount       Decimal           @default(1000000)
  
  minRate         Decimal
  maxRate         Decimal
  
  minTerm         Int               @default(1)
  maxTerm         Int               @default(60)
  
  requirements    Json?             @default("{}")
  
  isActive        Boolean           @default(true)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}


model LearningClick {
  id        String   @id @default(uuid())
  moduleId  String
  clickedAt DateTime @default(now())

  @@index([moduleId, clickedAt])
}

enum TokenType {
  SAFRA
  MATERIAL
  MAQUINARIO
}

enum TokenStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REDEEMED
  CANCELLED
}

model AgroToken {
  id          String      @id @default(uuid())
  propertyId  String
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        TokenType
  status      TokenStatus @default(DRAFT)
  title       String
  description String?

  totalValue  Decimal
  tokenPrice  Decimal     @default(100)
  totalTokens Int
  soldTokens  Int         @default(0)

  expectedReturn Decimal?
  periodMonths   Int?

  // Safra
  commodity    String?
  quantityKg   Decimal?
  deliveryDate DateTime?
  fieldId      String?

  // Material
  materialType String?
  quantity     Decimal?
  unit         String?

  // Maquinário
  machineType  String?
  machineModel String?
  machineYear  Int?
  usageHours   Decimal?

  carNumber         String?
  contractUrl       String?
  blockchainTx      String?
  originacaoFee     Decimal?
  successFee        Decimal?

  clicksignDocKey   String?
  clicksignSignerKey String?
  signedAt          DateTime?

  transactions TokenTransaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
}

model TokenTransaction {
  id            String    @id @default(uuid())
  tokenId       String
  token         AgroToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation(fields: [buyerId], references: [id])
  quantity      Int
  pricePerToken Decimal
  totalAmount   Decimal
  commission    Decimal
  type          String    @default("BUY")
  createdAt     DateTime  @default(now())

  @@index([tokenId])
  @@index([buyerId])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  type      String
  severity  String   @default("MEDIUM")
  userId    String?
  tokenId   String?
  stripeId  String?
  details   Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ── Pecuária Inteligente ──────────────────────────────────────────────────────

enum AnimalSexo {
  MACHO
  FEMEA
}

enum ObjetivoLote {
  ABATE
  LEITE
  REPRODUCAO
  RECRIA
  ENGORDA
  RECRIA_ENGORDA
}

enum StatusLote {
  ATIVO
  ENCERRADO
  CANCELADO
}

enum TipoRegistroSaude {
  VACINA
  MEDICACAO
  EXAME
  DIAGNOSTICO
  OBSERVACAO
}

enum TipoMovimento {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  ABATE
  NASCIMENTO
}

model Lote {
  id                String       @id @default(uuid())
  propertyId        String
  property          Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  nome              String
  cabecas           Int
  racaPredominante  String?
  idadeMediaMeses   Int?
  pesoMedioEntrada  Float
  objetivo          ObjetivoLote @default(ABATE)
  pesoMetaAbate     Float?
  dataEntrada       DateTime     @default(now())
  dataSaidaPrevista DateTime?
  dataEncerramento  DateTime?
  custoTotal        Float        @default(0)
  status            StatusLote   @default(ATIVO)
  faseAtual         String?
  metaGMD           Float?
  pesoInicioEngorda Float?
  dataInicioEngorda DateTime?
  sistemaProducao   String?
  numPiquetes       Int?
  areaHectares      Float?
  regiao            String?
  animais              Animal[]
  registrosDiarios     LoteDiario[]
  planosNutricionais   PlanoNutricional[]
  rotacoes             RotacaoPastagem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([propertyId])
}

model LoteDiario {
  id             String   @id @default(uuid())
  loteId         String
  lote           Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data           DateTime @default(now())
  consumoRacaoKg Float?
  consumoAguaL   Float?
  pesoMedio      Float?
  mortalidade    Int      @default(0)
  medicacao      String?
  observacoes    String?
  custoRacaoDia  Float?
  custoDia       Float?
  createdAt      DateTime @default(now())

  @@index([loteId])
  @@index([data])
}

model Animal {
  id               String    @id @default(uuid())
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  loteId           String?
  lote             Lote?     @relation(fields: [loteId], references: [id])
  identificacao    String
  brincoEletronico String?
  sisbovId         String?
  rfid             String?
  especie          String    @default("BOVINO")
  raca             String?
  sexo             AnimalSexo
  dataNascimento   DateTime?
  pesoNascimento   Float?
  pesoAtual        Float?
  origemFazenda    String?
  gtaOrigem        String?
  ativo            Boolean   @default(true)
  saude                AnimalSaude[]
  movimentos           AnimalMovimento[]
  eventosReprodutivos  EventoReprodutivo[]
  statusReprodutivo    StatusReprodutivo?
  producaoLeite        ProducaoLeite[]
  controleCarcaca      ControleCarcaca?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([propertyId])
  @@index([identificacao])
  @@index([sisbovId])
}

model AnimalSaude {
  id           String            @id @default(uuid())
  animalId     String
  animal       Animal            @relation(fields: [animalId], references: [id], onDelete: Cascade)
  tipo         TipoRegistroSaude @default(OBSERVACAO)
  descricao    String
  produto      String?
  dose         String?
  veterinario  String?
  dataRegistro DateTime          @default(now())
  proximaDose  DateTime?
  createdAt    DateTime          @default(now())

  @@index([animalId])
}

model AnimalMovimento {
  id         String        @id @default(uuid())
  animalId   String
  animal     Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  tipo       TipoMovimento
  origem     String?
  destino    String?
  peso       Float?
  data       DateTime      @default(now())
  gta        String?
  observacao String?
  createdAt  DateTime      @default(now())

  @@index([animalId])
}

// ── Saúde & Reprodução ────────────────────────────────────────────────────────

enum TipoEventoReprodutivo {
  CIO_DETECTADO
  INSEMINACAO_ARTIFICIAL
  MONTA_NATURAL
  DIAGNOSTICO_PRENHEZ
  CONFIRMACAO_PRENHEZ
  PARTO
  ABORTO
  DESMAME
  DESCARTE_REPRODUTIVO
}

enum StatusPrenhez {
  VAZIA
  PRENHA
  INCERTA
  PARIDA
}

model ProtocoloVacinal {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  nome         String
  doenca       String
  frequencia   String   @default("ANUAL")
  produto      String?
  dose         String?
  mesesAplicar Json     @default("[3,9]")
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([propertyId])
}

model EventoReprodutivo {
  id          String                @id @default(uuid())
  animalId    String
  animal      Animal                @relation(fields: [animalId], references: [id], onDelete: Cascade)
  tipo        TipoEventoReprodutivo
  data        DateTime              @default(now())
  touruId     String?
  veterinario String?
  resultado   String?
  pesoBezerro Float?
  observacao  String?
  createdAt   DateTime              @default(now())

  @@index([animalId])
}

model StatusReprodutivo {
  id                String        @id @default(uuid())
  animalId          String        @unique
  animal            Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  status            StatusPrenhez @default(VAZIA)
  dataUltimoCio     DateTime?
  dataInseminacao   DateTime?
  dataPrevistoParto DateTime?
  paricoes          Int           @default(0)
  updatedAt         DateTime      @updatedAt
}

// ── Nutrição & Pastagem ───────────────────────────────────────────────────────

model PlanoNutricional {
  id             String   @id @default(uuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  loteId         String?
  lote           Lote?    @relation(fields: [loteId], references: [id])
  nome           String
  objetivo       String   @default("GANHO_PESO")
  racaoKgDia     Float?
  proteinaBruta  Float?
  mineralKgDia   Float?
  custoKgRacao   Float?
  custoKgMineral Float?
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([propertyId])
}

model Pastagem {
  id            String            @id @default(uuid())
  propertyId    String
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  nome          String
  areaHectares  Float
  forrageira    String?
  capacidadeUA  Float?
  cicloDescanso Int?
  status        String            @default("DISPONIVEL")
  rotacoes      RotacaoPastagem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([propertyId])
}

model RotacaoPastagem {
  id         String   @id @default(uuid())
  pastagemId String
  pastagem   Pastagem @relation(fields: [pastagemId], references: [id], onDelete: Cascade)
  loteId     String?
  lote       Lote?    @relation(fields: [loteId], references: [id])
  entrada    DateTime @default(now())
  saida      DateTime?
  cabecas    Int?
  observacao String?
  createdAt  DateTime @default(now())

  @@index([pastagemId])
}

// ── Produção & Qualidade ──────────────────────────────────────────────────────

model ProducaoLeite {
  id          String   @id @default(uuid())
  animalId    String
  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  data        DateTime @default(now())
  litrosManha Float    @default(0)
  litrosTarde Float    @default(0)
  totalLitros Float    @default(0)
  ccs         Int?
  gordura     Float?
  proteina    Float?
  createdAt   DateTime @default(now())

  @@index([animalId])
  @@index([data])
}

model ControleCarcaca {
  id                String   @id @default(uuid())
  animalId          String   @unique
  animal            Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  dataAbate         DateTime
  pesoVivo          Float
  pesoCarcaca       Float?
  rendimentoCarcaca Float?
  classificacao     String?
  tipificacao       String?
  frigorificoNome   String?
  valorArroba       Float?
  receitaTotal      Float?
  observacao        String?
  createdAt         DateTime @default(now())

  @@index([dataAbate])
}

// ── Financeiro Pecuário ───────────────────────────────────────────────────────

enum TipoTransacaoGado {
  COMPRA
  VENDA
  LEILAO_COMPRA
  LEILAO_VENDA
}

model TransacaoGado {
  id          String            @id @default(uuid())
  propertyId  String
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tipo        TipoTransacaoGado
  data        DateTime          @default(now())
  cabecas     Int
  pesoTotal   Float?
  valorArroba Float?
  valorTotal  Float
  contraparte String?
  gta         String?
  comissao    Float             @default(0)
  observacao  String?
  createdAt   DateTime          @default(now())

  @@index([propertyId])
  @@index([data])
}

model ValuationRebanho {
  id                 String   @id @default(uuid())
  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  data               DateTime @default(now())
  totalAnimais       Int
  pesoTotalKg        Float
  valorArrobaRef     Float    @default(320)
  totalArrobas       Float
  valorTotalEstimado Float
  custoTotalRebanho  Float    @default(0)
  margemBruta        Float    @default(0)
  createdAt          DateTime @default(now())

  @@index([propertyId])
}

model EnergyRecord {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  source      String
  consumption Float    @default(0)
  production  Float    @default(0)
  cost        Float    @default(0)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, month, year])
  @@index([propertyId])
}

// ── Equipe IA — Agentes Autônomos ─────────────────────────────────────────────

enum AgentTipo {
  PRONTO
  PERSONALIZADO
}

enum AgentTrigger {
  CRON
  MANUAL
  EVENTO
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model AgentConfig {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome         String
  descricao    String?
  role         String
  tipo         AgentTipo    @default(PERSONALIZADO)
  tools        String[]
  trigger      AgentTrigger @default(MANUAL)
  schedule     String?
  modelo       String       @default("llama-3.3-70b-versatile")
  systemPrompt String?
  ativo        Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  runs         AgentRun[]

  @@index([userId])
}

model AgentRun {
  id         String      @id @default(uuid())
  agentId    String
  agent      AgentConfig @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId     String
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  status     RunStatus   @default(RUNNING)
  resultado  String?
  toolCalls  String?
  erro       String?

  @@index([agentId])
  @@index([userId])
}

model FieldOperation {
  id             String    @id @default(uuid())
  fieldId        String
  field          Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo           String
  larguraM       Float
  anguloGraus    Float
  velocidadeKmh  Float
  areaHa         Float
  passadas       Int
  comprimentoKm  Float
  tempoEstHoras  Float
  tempoRealMin   Float?
  combustivelL   Float?
  modoGps        Boolean   @default(false)
  serviceId      String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([fieldId])
  @@index([userId])
}

// ─── ORYON LEGAL ────────────────────────────────────────────────────────────

enum StatusReuniaoLegal {
  PENDENTE
  CONFIRMADA
  REAGENDADA
  CANCELADA
  CONCLUIDA
}

enum ModalidadeReuniao {
  ONLINE
  PRESENCIAL
}

model OryonLegalLead {
  id             String    @id @default(uuid())
  nome           String
  telefone       String
  email          String?
  cidade         String?
  estado         String?
  objetivo       String?
  origem         String    @default("arq2")
  score          Int?
  nivel          String?
  vulnerabilidades String?
  recomendacao   String?
  prioridade     String?
  resumo         String?
  respostas      String?
  createdAt      DateTime  @default(now())
  reunioes       ReuniaoLegal[]
}

model SlotDisponivel {
  id          String             @id @default(uuid())
  data        DateTime
  durMinutos  Int                @default(60)
  modalidade  ModalidadeReuniao  @default(ONLINE)
  ocupado     Boolean            @default(false)
  createdAt   DateTime           @default(now())
  reunioes    ReuniaoLegal[]
}

model ReuniaoLegal {
  id          String                @id @default(uuid())
  leadId      String
  lead        OryonLegalLead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  slotId      String?
  slot        SlotDisponivel?       @relation(fields: [slotId], references: [id])
  status      StatusReuniaoLegal    @default(PENDENTE)
  modalidade  ModalidadeReuniao     @default(ONLINE)
  linkOnline  String?
  observacoes String?
  googleEventId String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([leadId])
  @@index([slotId])
}

// ─── AQUICULTURA ──────────────────────────────────────────────────────────────

enum TipoTanque {
  ESCAVADO
  TANQUE_REDE
  RACEWAY
  ACUDE
  VIVEIRO
}

enum StatusLoteAqua {
  ATIVO
  ENCERRADO
  CANCELADO
}

model TanqueAqua {
  id            String     @id @default(uuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  nome          String
  tipo          TipoTanque @default(ESCAVADO)
  areaM2        Float?
  volumeM3      Float?
  profundidadeM Float?
  localizacao   String?
  ativo         Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lotesAqua     LoteAqua[]
  qualidadeAgua QualidadeAguaReg[]

  @@index([propertyId])
}

model LoteAqua {
  id                 String         @id @default(uuid())
  propertyId         String
  property           Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tanqueId           String
  tanque             TanqueAqua     @relation(fields: [tanqueId], references: [id], onDelete: Cascade)
  nome               String
  especie            String
  quantidadeInicial  Int
  quantidadeAtual    Int
  pesoMedioEntradaG  Float?
  dataPovamento      DateTime       @default(now())
  dataDespescaPrev   DateTime?
  dataEncerramento   DateTime?
  status             StatusLoteAqua @default(ATIVO)
  observacao         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  biometrias         BiometriaAqua[]
  arracoamentos      ArracoamentoDiario[]
  mortalidades       MortalidadeAqua[]
  despescas          DespescaAqua[]
  tratamentos        TratamentoAqua[]
  vendasAqua         VendaAqua[]

  @@index([propertyId])
  @@index([tanqueId])
}

model BiometriaAqua {
  id            String   @id @default(uuid())
  loteId        String
  lote          LoteAqua @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data          DateTime @default(now())
  amostragem    Int
  pesoMedioG    Float
  comprimentoCm Float?
  biomasseKg    Float?
  observacao    String?
  createdAt     DateTime @default(now())

  @@index([loteId])
}

model ArracoamentoDiario {
  id           String   @id @default(uuid())
  loteId       String
  lote         LoteAqua @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data         DateTime @default(now())
  tipoRacao    String?
  quantidadeKg Float
  custoKg      Float?
  observacao   String?
  createdAt    DateTime @default(now())

  @@index([loteId])
}

model QualidadeAguaReg {
  id              String     @id @default(uuid())
  tanqueId        String
  tanque          TanqueAqua @relation(fields: [tanqueId], references: [id], onDelete: Cascade)
  data            DateTime   @default(now())
  ph              Float?
  oxigenioMgL     Float?
  temperaturaC    Float?
  amoniaMgL       Float?
  nitritoMgL      Float?
  turbidezNTU     Float?
  alcalinidadeMgL Float?
  observacao      String?
  alertas         String?
  createdAt       DateTime   @default(now())

  @@index([tanqueId])
}

model MortalidadeAqua {
  id            String   @id @default(uuid())
  loteId        String
  lote          LoteAqua @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data          DateTime @default(now())
  quantidade    Int
  causaSuspeita String?
  tratamento    String?
  observacao    String?
  createdAt     DateTime @default(now())

  @@index([loteId])
}

model TratamentoAqua {
  id            String   @id @default(uuid())
  loteId        String
  lote          LoteAqua @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data          DateTime @default(now())
  medicamento   String
  dosagem       String?
  carenciaDias  Int?
  motivoCID     String?
  observacao    String?
  createdAt     DateTime @default(now())

  @@index([loteId])
}

model DespescaAqua {
  id              String   @id @default(uuid())
  loteId          String
  lote            LoteAqua @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data            DateTime @default(now())
  quantidadePeixe Int
  pesoTotalKg     Float
  pesoMedioG      Float?
  rendimentoPerc  Float?
  destinoVenda    String?
  precoKg         Float?
  receita         Float?
  observacao      String?
  createdAt       DateTime @default(now())

  @@index([loteId])
}

model VendaAqua {
  id          String   @id @default(uuid())
  loteId      String
  lote        LoteAqua @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data        DateTime @default(now())
  especie     String
  pesoKg      Float
  precoKg     Float
  total       Float
  comprador   String?
  canal       String?
  observacao  String?
  createdAt   DateTime @default(now())

  @@index([loteId])
}

model DocumentoAqua {
  id          String    @id @default(uuid())
  propertyId  String
  tipo        String
  numero      String?
  orgao       String?
  emissao     DateTime?
  vencimento  DateTime?
  status      String    @default("VIGENTE")
  arquivo     String?
  observacao  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([propertyId])
}
